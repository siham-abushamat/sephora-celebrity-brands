/*==================================================================
  Program : 06_rhode_detailed_data.sas
  Purpose : A second, more detailed Rhode dataset with full
            ingredient lists and product highlights.
            Kept for reference: it is NOT part of COMBINED_DATA.
            The analysis uses the Rhode rows in
            01_import_and_combine.sas.
  Output  : WORK.RHODE_DETAILED   (celebrity_brand = 1)
  Note    : Product P2895985 (Peptide Lip Shape) appears twice,
            with different loves and categories.
==================================================================*/

data rhode_detailed;
    length
        product_id         $ 11
        product_name       $ 107
        brand_id           $ 8
        brand_name         $ 33
        loves_count          8
        rating               8
        reviews              8
        size               $ 65
        ingredients        $ 16488
        price_usd            8
        highlights         $ 192
        primary_category   $ 15
        secondary_category $ 25 ;

    infile datalines dsd delimiter='|';

    input
        product_id         : $11.
        product_name       : $107.
        brand_id           : $8.
        brand_name         : $33.
        loves_count        : ?? best32.
        rating             : ?? best32.
        reviews            : ?? best32.
        size               : $65.
        ingredients        : $16488.
        price_usd          : ?? best32.
        highlights         : $192.
        primary_category   : $15.
        secondary_category : $25. ;

    /* "-" in the data means the value is not available */
    if size        = '-' then size        = ' ';
    if ingredients = '-' then ingredients = ' ';

    celebrity_brand = 1;

datalines;
